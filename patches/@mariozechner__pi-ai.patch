+        let breakpointsPlaced = 0;
+        const maxBreakpoints = 3;
+        const placeBp = (msg) => {
+            if (Array.isArray(msg.content)) {
+                const lastBlock = msg.content[msg.content.length - 1];
+                if (lastBlock && (lastBlock.type === "text" || lastBlock.type === "image" || lastBlock.type === "tool_result")) {
+                    lastBlock.cache_control = cacheControl;
+                    breakpointsPlaced++;
+                }
+            }
+            else if (typeof msg.content === "string") {
+                msg.content = [{ type: "text", text: msg.content, cache_control: cacheControl }];
+                breakpointsPlaced++;
+            }
+        };
+        // Phase 1: Anchor — last real user message (not tool_result)
+        let anchorIdx = -1;
+        for (let idx = params.length - 1; idx >= 0; idx--) {
+            const msg = params[idx];
+            if (msg.role === "user" && !(Array.isArray(msg.content) && msg.content[0] && msg.content[0].type === "tool_result")) {
+                anchorIdx = idx;
+                break;
+            }
+        }
+        if (anchorIdx >= 0)
+            placeBp(params[anchorIdx]);
+        // Phase 2: Fill-forward — user messages after anchor (including tool_result)
